# Reverse proxy с автоматическим HTTPS от Let's Encrypt.
# Caddy сам получает сертификат при первом запуске и продлевает его в фоне.
{$DOMAIN} {
	encode gzip
	reverse_proxy app:8080
	tls {$ACME_EMAIL}
}

# brewatlas.ru — отдельное приложение в контейнере brewatlas-app (порт 8000),
# доступно через общую сеть stamm-frontend-network.
brewatlas.ru {
	encode gzip
	reverse_proxy brewatlas-app:8000
	tls {$ACME_EMAIL}
}
