# Для Docker-запуска (docker compose) задайте эти переменные; в обычном dev-режиме они не нужны:
#   DOMAIN       — публичный домен для Caddy / Let's Encrypt
#   ACME_EMAIL   — e-mail для уведомлений ACME
# Для продакшена также поменяйте: APP_ENV=production, PUBLIC_BASE_URL=https://<домен>.
DOMAIN=stammbeer.ru
ACME_EMAIL=mailer@example.com

APP_ENV=development
DATABASE_URL=sqlite:///var/stamm.sqlite3
SESSION_SECRET=change-me
ADMIN_EMAIL=admin
ADMIN_PASSWORD=1
MOYSKLAD_API_BASE_URL=https://api.moysklad.ru/api/remap/1.2
PUBLIC_BASE_URL=http://127.0.0.1:8080
EMAIL_PROVIDER=yandex
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.yandex.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USERNAME=mailer@example.com
EMAIL_SMTP_PASSWORD=app-password-from-yandex
EMAIL_FROM_EMAIL=mailer@example.com
EMAIL_FROM_NAME=Stamm Brewing
